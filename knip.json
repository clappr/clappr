{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "vite": false,
  "compilers": {
    "scss": true,
    "sass": true
  },
  "workspaces": {
    ".": {
      "entry": ["test/dist-contract.js", "vite.config.base.mjs", "vitest.config.base.mjs"],
      "project": ["test/**/*.{js,scss,sass}"],
      "vitest": { "config": ["vitest.config.base.mjs"] },
      "babel": { "config": ["babel.base.json"] }
    },
    "packages/*": {
      "entry": ["vite.config.mjs", "vitest.config.mjs"],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/clappr-core": {
      "entry": [
        "src/main.js",
        "src/base/scss/**/*.{scss,sass}",
        "vite.config.mjs",
        "vitest.config.mjs"
      ],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "paths": {
        "@/*": ["./src/*"]
      },
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/clappr-plugins": {
      "entry": [
        "src/main.js",
        "src/plugins/*/*.js",
        "src/plugins/*.js",
        "!src/plugins/**/*.test.js",
        "vite.config.mjs",
        "vitest.config.mjs"
      ],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/clappr-telemetry": {
      "entry": ["src/main.js", "src/main.umd.js", "vite.config.mjs", "vitest.config.mjs"],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/clappr-zepto": {
      "entry": ["src/zepto.js", "vite.config.mjs", "vitest.config.mjs"],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/hlsjs-playback": {
      "entry": ["src/hls.js", "vite.config.mjs", "vitest.config.mjs"],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/dash-shaka-playback": {
      "entry": ["src/clappr-dash-shaka-playback.js", "vite.config.mjs", "vitest.config.mjs"],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/html5-tvs-playback": {
      "entry": ["src/html5_playback.js", "vite.config.mjs", "vitest.config.mjs"],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "packages/player": {
      "entry": ["src/main.js", "src/base_bundle.js", "vite.config.mjs", "vitest.config.mjs"],
      "project": ["src/**/*.{js,scss,sass}", "*.{js,mjs}"],
      "vitest": { "config": ["vitest.config.mjs"] },
      "babel": true,
      "postcss": true
    },
    "apps/clappr.io": {
      "project": ["**/*.{js,jsx,ts,tsx,mdx,scss,sass}"],
      "docusaurus": true,
      "ignoreDependencies": ["@docusaurus/types", "@docusaurus/plugin-content-docs"]
    }
  }
}
