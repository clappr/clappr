{
  "name": "@clappr/clappr-html5-tvs-playback",
  "version": "0.4.1",
  "description": "A Clappr HTML5 playback for smart TVs based on HbbTV 2.0.1 specs.",
  "keywords": [
    "clappr",
    "smarttv",
    "video",
    "HTML5",
    "HBBTV"
  ],
  "homepage": "https://github.com/clappr/clappr/tree/main/packages/html5-tvs-playback",
  "bugs": {
    "url": "https://github.com/clappr/clappr/issues",
    "email": "player-web@g.globo"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Globo (digital hub)",
    "email": "player-web@g.globo"
  },
  "files": [
    "/dist",
    "/src"
  ],
  "main": "./dist/clappr-html5-tvs-playback.js",
  "module": "./dist/clappr-html5-tvs-playback.esm.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/clappr/clappr.git",
    "directory": "packages/html5-tvs-playback"
  },
  "scripts": {
    "bundle-check": "ANALYZE_BUNDLE=true rollup --config --bundleConfigAsCjs",
    "build": "rollup --config --bundleConfigAsCjs",
    "release": "MINIMIZE=true rollup --config --bundleConfigAsCjs",
    "prepublishOnly": "lerna run release --scope=@clappr/clappr-html5-tvs-playback",
    "start": "DEV=true rollup --config --bundleConfigAsCjs --watch",
    "watch": "rollup --config --bundleConfigAsCjs --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest ./src --coverage --silent",
    "test:watch": "jest ./src --watch",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand"
  },
  "peerDependencies": {
    "@clappr/core": "*"
  },
  "dependencies": {
    "@babel/runtime": "^7.13.8"
  },
  "devDependencies": {
    "@babel/core": "^7.14.2",
    "@babel/plugin-transform-runtime": "^7.13.10",
    "@babel/preset-env": "^7.14.2",
    "@clappr/core": "^0.14.1",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "babel-jest": "^26.6.3",
    "eslint": "8.49.0",
    "jest": "^26.6.3",
    "jest-environment-jsdom": "^26.6.2",
    "jest-mock-console": "^1.0.1",
    "rollup": "^3.30.0",
    "rollup-plugin-filesize": "^9.1.1",
    "rollup-plugin-serve": "^1.1.0",
    "rollup-plugin-sizes": "^1.0.4",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-visualizer": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not ie <= 11"
  ],
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^release"
        ]
      }
    }
  }
}
