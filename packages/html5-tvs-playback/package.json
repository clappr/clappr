    "name": "Globo (digital hub)",
    "email": "player-web@g.globo"
  },
  "files": [
    "/dist",
    "/src"
  ],
  "main": "./dist/clappr-html5-tvs-playback.js",
  "module": "./dist/clappr-html5-tvs-playback.esm.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/clappr/clappr.git",
    "directory": "packages/html5-tvs-playback"
  },
  "scripts": {
    "bundle-check": "ANALYZE_BUNDLE=true rollup --config --bundleConfigAsCjs",
    "build": "rollup --config --bundleConfigAsCjs",
