{
  "name": "dash-shaka-playback",
  "version": "4.0.0",
  "description": "clappr dash playback based on shaka player",
  "main": "./dist/dash-shaka-playback.js",
  "module": "./dist/dash-shaka-playback.esm.mjs",
  "exports": {
    ".": {
      "import": "./dist/dash-shaka-playback.esm.mjs",
      "require": "./dist/dash-shaka-playback.js",
      "default": "./dist/dash-shaka-playback.js"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clappr/clappr.git",
    "directory": "packages/dash-shaka-playback"
  },
  "scripts": {
    "start": "DEV=true rollup --config --bundleConfigAsCjs --watch",
    "start:with-reload": "DEV=true RELOAD=true rollup --config --bundleConfigAsCjs --watch",
    "build": "rollup --config --bundleConfigAsCjs",
    "watch": "rollup --config --bundleConfigAsCjs --watch",
    "bundle-check": "ANALYZE_BUNDLE=true rollup --config --bundleConfigAsCjs",
    "release": "MINIMIZE=true rollup --config --bundleConfigAsCjs",
    "lint": "eslint *.js ./src",
    "lint:fix": "yarn lint -- --fix",
    "test": "jest ./src --testPathIgnorePatterns=dist.smoke --coverage --silent && yarn release && jest ./src/dist.smoke.test.js --silent",
    "test:watch": "jest ./src --watch",
    "prepublishOnly": "lerna run release --scope=dash-shaka-playback"
  },
  "files": [
    "/dist",
    "/src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Clappr team",
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@clappr/core": "*",
    "shaka-player": "^3"
  },
  "devDependencies": {
    "@clappr/core": "^0.14.8",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-serve": "^2.0.2",
    "shaka-player": "^3.0.7"
  }
}
