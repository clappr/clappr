{
  "name": "clappr-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run start --scope=@clappr/player",
    "lint": "lerna run lint && eslint test/",
    "lint:fix": "lerna run lint -- --fix && eslint test/ --fix",
    "knip": "knip",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "release": "lerna version --include-merged-tags --no-push --yes",
    "prepare": "husky",
    "test": "lerna run test --no-bail && vitest run --dir test --passWithNoTests --globals",
    "test:smoke": "lerna run test:smoke --no-bail",
    "build": "lerna run build --scope=@clappr/player --include-dependencies",
    "build:dist": "lerna run release"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.4",
    "autoprefixer": "^10.5.4",
    "browserslist": "^4.28.8",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.6",
    "jsdom": "^26.1.0",
    "knip": "^6.32.1",
    "lerna": "^10.0.0",
    "postcss": "^8.4.29",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.93.2",
    "terser": "^5.50.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
