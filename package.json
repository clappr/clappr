{
  "name": "clappr-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run start --scope=@clappr/player",
    "lint": "lerna run lint && eslint test/",
    "lint:fix": "lerna run lint -- --fix && eslint test/ --fix",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "release": "lerna version --include-merged-tags --no-push --yes",
    "prepare": "husky",
    "test": "lerna run test --no-bail",
    "test:smoke": "lerna run test:smoke --no-bail",
    "build": "lerna run build --scope=@clappr/player --include-dependencies",
    "build:dist": "lerna run release"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-terser": "^1.0.0",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.4",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.6",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock-console": "^2.0.0",
    "jsdom": "^26.1.0",
    "lerna": "^10.0.0",
    "postcss": "^8.4.29",
    "prettier": "^3.6.2",
    "rollup": "^3.30.0",
    "rollup-plugin-html": "^0.2.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svg": "^2.0.0",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.93.2",
    "semver": "^7.7.3"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
